<%- include('partials/header') %>

<div class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-lg w-full space-y-8 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md p-8 sm:p-10 rounded-3xl border border-slate-200/70 dark:border-slate-800/80 shadow-xl">
    
    <div class="text-center">
      <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white font-extrabold text-2xl flex items-center justify-center mx-auto mb-3 shadow-md">
        ON
      </div>
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Create your Student Profile</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Start receiving personalized, explainable opportunity rankings</p>
    </div>

    <% if (error) { %>
      <div class="p-4 bg-rose-50/90 dark:bg-rose-950/60 backdrop-blur-md border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-sm rounded-2xl font-medium">
        <%= error %>
      </div>
    <% } %>

    <form class="mt-8 space-y-5" action="/signup" method="POST">
      <div>
        <label for="name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Full Name</label>
        <input id="name" name="name" type="text" required class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-900 dark:text-slate-100 text-sm bg-white/90 dark:bg-slate-800/90 placeholder-slate-400 dark:placeholder-slate-500" placeholder="e.g. Alex Rivera">
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Student Email Address</label>
        <input id="email" name="email" type="email" required class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-900 dark:text-slate-100 text-sm bg-white/90 dark:bg-slate-800/90 placeholder-slate-400 dark:placeholder-slate-500" placeholder="alex@university.edu">
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Password</label>
        <input id="password" name="password" type="password" required class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-900 dark:text-slate-100 text-sm bg-white/90 dark:bg-slate-800/90 placeholder-slate-400 dark:placeholder-slate-500" placeholder="••••••••">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="education_level" class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Education Level</label>
          <select id="education_level" name="education_level" class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-900 dark:text-slate-100 text-sm bg-white/90 dark:bg-slate-800/90">
            <option value="High School">High School</option>
            <option value="Undergraduate" selected>Undergraduate</option>
            <option value="Master's">Master's</option>
            <option value="PhD">PhD</option>
            <option value="Bootcamp / Self-Taught">Bootcamp / Self-Taught</option>
          </select>
        </div>

        <div>
          <label for="field_of_study" class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Field of Study</label>
          <input id="field_of_study" name="field_of_study" type="text" value="Computer Science" required class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-900 dark:text-slate-100 text-sm bg-white/90 dark:bg-slate-800/90 placeholder-slate-400 dark:placeholder-slate-500" placeholder="e.g. Computer Science">
        </div>
      </div>

      <div>
        <button type="submit" class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-95 hover:shadow-indigo-500/20 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 mt-4">
          Create Account & Set Skills &rarr;
        </button>
      </div>
    </form>

    <div class="text-center pt-4 border-t border-slate-100 dark:border-slate-800">
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Already registered? <a href="/login" class="font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 rounded-sm">Log in here</a>
      </p>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
