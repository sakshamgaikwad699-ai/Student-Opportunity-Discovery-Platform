  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Covering All Key Opportunity Categories</h2>
    
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4">
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-hackathon px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Hackathon</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">48h Challenges</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-internship px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Internship</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Summer Roles</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-scholarship px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Scholarship</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Merit & Diversity</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-certification px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Certification</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">AWS & Google</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-competition px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Competition</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Kaggle & CTFs</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-workshop px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Workshop</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Hands-on Labs</span>
      </div>
      <div class="p-4 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/70 dark:border-slate-800/80 shadow-xs text-center">
        <span class="badge-course px-2.5 py-1 rounded-full text-xs font-bold block mb-2">Course</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Guided Learning</span>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
